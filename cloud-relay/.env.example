PORT=8080

# Должен совпадать с RELAY_TOKEN в local-server/.env
RELAY_TOKEN=change-me-shared-with-relay

# Токены веб-клиентов больше не задаются здесь: каждая инсталляция сама
# регистрируется через POST /api/register и получает свой токен.
# Список инсталляций: GET /api/installations (Bearer <RELAY_TOKEN>).
# Хранится в /app/data/installations.json — см. volume в docker-compose.yml.
