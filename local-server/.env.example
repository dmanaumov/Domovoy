PORT=3000
MQTT_URL=mqtt://mosquitto:1883
DEVICES_FILE=./devices.json

# Токен для доступа к REST/WS API этого сервера из локальной сети (веб-клиент).
LOCAL_TOKEN=change-me

# Если хотите доступ извне через облачный релей — заполните оба.
# Оставьте RELAY_URL пустым, чтобы работать только локально.
RELAY_URL=wss://your-domovoy-relay.example.com
RELAY_TOKEN=change-me-shared-with-relay
